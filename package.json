{
  "name": "skytrack",
  "version": "0.7.2",
  "description": "Free desktop flight tracker using open ADS-B data. No account or API key needed.",
  "license": "MIT",
  "author": "Samet Duhan Şahin",
  "keywords": [
    "flight-tracker",
    "adsb",
    "electron",
    "leaflet"
  ],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.skytrack",
    "productName": "SkyTrack",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "node_modules/leaflet/dist/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "SkyTrack-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "artifactName": "SkyTrack-mac-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "artifactName": "SkyTrack-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SametDuhan",
        "repo": "airock"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SametDuhan/airock.git"
  }
}
